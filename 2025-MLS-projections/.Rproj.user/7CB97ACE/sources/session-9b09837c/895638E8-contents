# ssb-hist-year.R
# Plots histogram of the spawning biomass distribution by year
# Load required package
library(ggplot2)

# Prompt user for a valid positive integer scenario number
repeat {
  scenario_input <- readline(prompt = "Enter a positive integer scenario number: ")
  if (grepl("^[1-9][0-9]*$", scenario_input)) break
  cat("Invalid input. Please enter a positive integer (e.g., 1, 2, 3...).\n")
}

# Ask user whether to input a custom biomass cap
custom_cap_prompt <- readline(prompt = "Would you like to enter a custom maximum biomass cap? [y/n]: ")
custom_cap_prompt <- tolower(trimws(custom_cap_prompt))
use_custom_cap <- custom_cap_prompt == "" || custom_cap_prompt == "y"

# Set default biomass cap
default_cap <- 12000

# If yes, prompt for value; otherwise use default
if (use_custom_cap) {
  biomass_cap_input <- readline(prompt = paste0("Enter a maximum biomass cap in mt (default = ", default_cap, "): "))
  biomass_cap <- suppressWarnings(as.numeric(biomass_cap_input))
  if (is.na(biomass_cap) || biomass_cap <= 0) biomass_cap <- default_cap
} else {
  biomass_cap <- default_cap
}

# Build file path using the scenario number
file_path <- paste0("2025_MLS_scenario", scenario_input, "-auxiliary.xx3")

# Read all lines from the file
lines <- readLines(file_path)

# Function to check if a line has exactly 14 numeric values
is_valid_numeric_line <- function(line) {
  nums <- strsplit(trimws(line), "\\s+")[[1]]
  length(nums) == 14 && all(suppressWarnings(!is.na(as.numeric(nums))))
}

# Filter lines that are valid (14 numeric values)
valid_lines <- lines[sapply(lines, is_valid_numeric_line)]

# Convert valid lines into a numeric matrix
sb <- do.call(rbind, lapply(valid_lines, function(line) as.numeric(strsplit(trimws(line), "\\s+")[[1]])))

# Set column names to years 2021 to 2034
colnames(sb) <- as.character(2021:2034)

# Compute 99.5th percentile across all spawning biomass values
x_995 <- quantile(sb, 0.995)
x_max <- min(biomass_cap, ceiling(x_995 / 1000) * 1000)

# Prompt user for a year
repeat {
  user_input <- readline(prompt = "Enter a year from 2021 to 2034: ")
  if (user_input %in% colnames(sb)) break
  cat("Invalid input. Please enter a valid year from 2021 to 2034.\n")
}

# Extract spawning biomass values for the selected year
year_values <- sb[, user_input]

# Compute summary statistics
median_val <- median(year_values)
ci_80 <- quantile(year_values, probs = c(0.10, 0.90))
p_rebuilt <- signif(mean(year_values > 3660), digits = 2)

# Create data frame for plotting
plot_df <- data.frame(Biomass = year_values)

# Create ggplot object with updated subtitle using ≈
p <- ggplot(plot_df, aes(x = Biomass)) +
  geom_histogram(aes(y = ..density..), bins = 30, fill = "skyblue", color = "black") +
  geom_density(color = "red", size = 1) +
  geom_vline(xintercept = median_val, linetype = "dashed", color = "black", size = 1) +
  geom_vline(xintercept = 3660, linetype = "solid", color = "darkgreen", size = 1) +
  scale_x_continuous(
    limits = c(0, x_max),
    breaks = seq(0, x_max, by = 2000)
  ) +
  labs(
    x = "Spawning biomass (mt)",
    y = "Density",
    title = paste("Spawning Biomass Distribution in", user_input),
    subtitle = sprintf(
      "P(Rebuilt) ≈ %.2g, Median = %.0f, 80%% CI = [%.0f, %.0f]",
      p_rebuilt, median_val, ci_80[1], ci_80[2]
    )
  ) +
  theme_minimal()

# Display the plot in RStudio
print(p)

# Save the plot as PNG
output_file <- paste0("ssb-hist-", scenario_input, "-", user_input, ".png")
ggsave(output_file, plot = p, width = 8, height = 6, dpi = 300)

# Notify user
cat("Figure saved to", output_file, "\n")
